# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# MongoDB Atlas connection URI for automatic daily cloud backups and user snapshots
MONGO_URI=

# Cloudinary credentials for high-speed media & architectural project image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP credentials for sending 5-digit OTP verification codes during Data Restore
ADMIN_EMAIL=
ADMIN_EMAIL_PASSWORD=

# APP_URL: The URL where this applet is hosted.
APP_URL=
